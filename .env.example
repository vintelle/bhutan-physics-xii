# PostgreSQL connection string
DATABASE_URL="postgresql://physics:physics@localhost:5432/physics_xii?schema=public"

# 32+ random characters used to sign session cookies:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Claude API key for the AI tutor, question generator and open-answer grading.
# Without it the platform still runs: quizzes, feedback, hints, analytics and
# keyword-based grading of conceptual answers work; AI features show a notice.
ANTHROPIC_API_KEY=""

# Optional overrides
CLAUDE_MODEL="claude-opus-5-5"

# Session cookies are Secure (HTTPS-only) in production. Set to "false" ONLY if you serve over plain HTTP on a closed LAN.
# COOKIE_SECURE="true"

# Optional: require this code for teacher sign-up
# TEACHER_SIGNUP_CODE=""
# Set to "true" to add demo accounts and practice history (for trying the platform; never in production)
# SEED_DEMO="true"
